<?xml version="1.0" encoding="utf-8"?>
<!--
    Cấu hình An toàn Mạng cho bản Debug (Chỉ áp dụng trong quá trình phát triển):
    - trust-anchors: Bổ sung src="user" cho phép các công cụ Debug Proxy (Charles, Proxyman, mitmproxy)
      hoạt động được khi lập trình viên cài chứng chỉ giám sát vào máy ảo/thiết bị test.
    - domain-config cleartextTrafficPermitted="true": Chỉ mở kết nối HTTP không mã hóa cho đúng 3 địa chỉ
      máy chủ cục bộ: 10.0.2.2 (IP loopback của máy chủ chạy trên máy tính truy cập từ Android Emulator),
      localhost và 127.0.0.1.
    - Các domain khác ra internet vẫn bắt buộc dùng HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
