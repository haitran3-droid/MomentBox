<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- S10: xin theo API lúc người dùng mở thư viện, không xin quyền quản lý toàn bộ bộ nhớ. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- S11: camera/micro chỉ xin khi người dùng chụp hoặc quay có tiếng. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- S20: quyền đặc biệt do người dùng cấp; thiếu quyền vẫn dùng lịch inexact.
         Không dùng USE_EXACT_ALARM tự cấp hoặc hạ target để né Settings. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Quyền truy cập mạng internet để gọi REST API (DummyJSON / MB Server) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Quyền kiểm tra trạng thái kết nối mạng (Wi-Fi, 4G/5G, có kết nối internet hay không) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MomentBoxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MomentBox">
        <!-- SystemUI dùng PendingIntent explicit; receiver không nhận broadcast từ app khác. -->
        <receiver
            android:name=".core.notification.ChatActionReceiver"
            android:exported="false" />

        <activity
            android:name=".feature.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".feature.settings.PermissionsActivity"
            android:exported="false" />
        <activity
            android:name=".feature.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".feature.profile.ProfileLinkActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="user"
                    android:scheme="momentbox" />
            </intent-filter>
        </activity>
        <activity
            android:name=".feature.chat.ChatImageActivity"
            android:exported="false" />
        <!-- Chat chỉ mở nội bộ hoặc PendingIntent explicit do app tạo; không nhận ID từ app khác. -->
        <activity
            android:name=".feature.chat.ChatActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Service riêng process, Binder chỉ nội bộ cùngUID; không start từBOOT. -->
        <activity
            android:name=".feature.player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <service
            android:name=".feature.player.PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:process=":player" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".feature.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MomentBox.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".feature.onboarding.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".feature.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".feature.postdetail.PostDetailActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="post"
                    android:scheme="momentbox" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="momentbox.dev"
                    android:pathPrefix="/post"
                    android:scheme="https" />
            </intent-filter>
        </activity>
        <activity
            android:name=".feature.videoplayer.VideoPlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.MomentBox.VideoPlayer" />
        <activity
            android:name=".feature.journal.editor.JournalEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.journal.stats.JournalStatsActivity"
            android:exported="false" />
        <activity
            android:name=".feature.recorder.RecorderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.create.CreateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".feature.recorder.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <receiver
            android:name=".data.repository.UploadCancelReceiver"
            android:exported="false" />

        <provider
            android:name=".core.media.CreateMediaFileProvider"
            android:authorities="${applicationId}.media"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/create_media_paths" />
        </provider>

        <service
            android:name=".feature.reminder.ReminderRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".feature.reminder.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".feature.reminder.ReminderActionReceiver"
            android:exported="false" />
        <!-- Task riêng cho màn nhắc; không export và không giữ card trong Recents. -->
        <activity
            android:name=".feature.reminder.ReminderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="${applicationId}.reminder"
            android:theme="@style/Theme.MomentBox.Reminder" />
        <!-- Action hệ thống được OS bảo vệ. Không thêm custom/unprotected action vào receiver exported. -->
        <receiver
            android:name=".feature.reminder.ReminderRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
