        <selector>
            <item android:state_selected="true">
                <shape android:shape="oval">
                    <solid android:color="@color/primary_container" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@android:color/transparent" />
