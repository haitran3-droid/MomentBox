<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CSS outer box-shadows chỉ vẽ ngoài border: dùng hai vành riêng để alpha không cộng vào tâm. -->
    <item>
        <shape
            android:innerRadius="70dp"
            android:shape="ring"
            android:thickness="18dp"
            android:useLevel="false">
            <solid android:color="#06FFFFFF" />
        </shape>
    </item>
    <item>
        <shape
            android:innerRadius="52dp"
            android:shape="ring"
            android:thickness="18dp"
            android:useLevel="false">
            <solid android:color="#0AFFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="36dp"
        android:left="36dp"
        android:right="36dp"
        android:top="36dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
