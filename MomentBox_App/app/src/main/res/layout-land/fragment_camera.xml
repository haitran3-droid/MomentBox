<?xml version="1.0" encoding="utf-8"?><!-- Camera tối: preview chiếm trọng số, controls không bị che khi chiều cao nhỏ. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.ntq.training.momentbox.feature.camera.CameraOverlayView
            android:id="@+id/camera_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#55000000"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/camera_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/m4_close"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/camera_flash"
                style="@style/Media.CameraControl"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/m4_flash_auto" />

            <TextView
                android:id="@+id/camera_timer"
                style="@style/Media.CameraControl"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/m4_timer_off" />

            <TextView
                android:id="@+id/camera_ratio"
                style="@style/Media.CameraControl"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="4:3" />
        </LinearLayout>

        <TextView
            android:id="@+id/camera_countdown"
            style="@style/Media.CameraControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/camera_error"
            style="@style/Media.CameraControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/camera_zoom"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="#66000000"
            android:orientation="horizontal" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/camera_filters"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/camera_video_mode"
            style="@style/Media.CameraControl"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/m4_videos" />

        <TextView
            android:id="@+id/camera_photo_mode"
            style="@style/Media.CameraControl"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/m4_photos"
            android:textColor="#FFD54F" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="34dp"
        android:paddingEnd="34dp">

        <ImageView
            android:id="@+id/camera_latest"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@string/m4_recent"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/camera_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_media_shutter"
                android:contentDescription="@string/m4_take_photo" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/camera_switch"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_switch_camera"
            android:src="@drawable/ic_media_cameraswitch"
            app:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>