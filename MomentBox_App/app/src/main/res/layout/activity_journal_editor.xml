<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <!-- App Bar (Cao 56dp theo chuẩn mockup) -->
    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/editor_title_new"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_draft_status_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_cloud_done" />

                <TextView
                    android:id="@+id/tv_draft_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:text="@string/editor_draft_saving"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/editor_save"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Nội dung cuộn chính -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Date/Time Chip -->
            <LinearLayout
                android:id="@+id/chip_datetime"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_calendar_month"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tv_datetime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    tools:text="Thứ Tư, 21/10/2026 · 21:30" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Mood Selector Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/editor_mood_question"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/mood_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Mood 1: Tuyệt vời -->
                <LinearLayout
                    android:id="@+id/layout_mood_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/circle_mood_1"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_mood_selected_1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="😄"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_label_mood_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="@string/mood_1_name"
                        android:textColor="@color/mood_1_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Mood 2: Vui -->
                <LinearLayout
                    android:id="@+id/layout_mood_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/circle_mood_2"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_mood_unselected">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🙂"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_label_mood_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="@string/mood_2_name"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Mood 3: Bình thường -->
                <LinearLayout
                    android:id="@+id/layout_mood_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/circle_mood_3"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_mood_unselected">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="😐"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_label_mood_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="@string/mood_3_name"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Mood 4: Buồn -->
                <LinearLayout
                    android:id="@+id/layout_mood_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/circle_mood_4"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_mood_unselected">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="😢"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_label_mood_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="@string/mood_4_name"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Mood 5: Tệ -->
                <LinearLayout
                    android:id="@+id/layout_mood_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/circle_mood_5"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_mood_unselected">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="😡"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_label_mood_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="@string/mood_5_name"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tiêu đề bài viết -->
            <EditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@null"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:hint="@string/editor_title_hint"
                android:inputType="textCapSentences"
                android:letterSpacing="-0.02"
                android:maxLength="100"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="22sp" />

            <!-- Nội dung bài viết -->
            <EditText
                android:id="@+id/et_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@null"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:gravity="top|start"
                android:hint="@string/editor_content_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.45"
                android:minLines="5"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="15sp" />

            <!-- Cảnh báo độ dài > 5.000 ký tự (không truncate theo BA) -->
            <TextView
                android:id="@+id/tv_length_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:text="@string/editor_warning_length"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Dải ảnh đính kèm (Thumbnail Strip) -->
            <LinearLayout
                android:id="@+id/layout_photos_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_photos"
                    android:layout_width="wrap_content"
                    android:layout_height="72dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_editor_photo" />

                <!-- Nút Thêm ảnh (Viền nét đứt 1.5dp) -->
                <LinearLayout
                    android:id="@+id/btn_add_photo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_dashed_photo_add"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_add_photo_alternate"
                        app:tint="@color/text_tertiary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="@string/editor_photo_add"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Thanh âm thanh đính kèm (Audio Attachment Bar) -->
            <LinearLayout
                android:id="@+id/layout_audio_attachment"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_audio_attachment"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/btn_audio_play_pause"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_btn_primary"
                    android:contentDescription="@string/action_like"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="@color/white" />

                <!-- Placeholder giả lập sóng âm 40 vạch theo mockup -->
                <View
                    android:id="@+id/view_audio_waveform"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@color/primary_variant"
                    android:alpha="0.25" />

                <TextView
                    android:id="@+id/tv_audio_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp"
                    tools:text="0:42" />

                <ImageButton
                    android:id="@+id/btn_remove_audio"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/journal_delete"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Dải nhãn (Tags Section) -->
            <LinearLayout
                android:id="@+id/layout_tags_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_tags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_editor_tag" />

                <!-- Nút Thêm Thẻ (Viền nét đứt) -->
                <LinearLayout
                    android:id="@+id/btn_add_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="@string/editor_tag_add"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Thanh Âm thanh nền (Ambient Audio Bar) -->
    <LinearLayout
        android:id="@+id/layout_ambient_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_ambient_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_primary">

            <ImageView
                android:id="@+id/iv_ambient_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rainy"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_ambient_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/editor_ambient_rain"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:alpha="0.7"
                    android:src="@drawable/ic_volume_down"
                    app:tint="@color/white" />

                <SeekBar
                    android:id="@+id/sb_ambient_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="60"
                    android:progressTint="@color/white"
                    android:thumbTint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_ambient_play_pause"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/action_like"
            android:src="@drawable/ic_pause"
            app:tint="@color/ambient_bar_bg" />
    </LinearLayout>

    <!-- Thanh công cụ soạn thảo phía dưới (Bottom Toolbar) -->
    <LinearLayout
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_tool_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/filter_has_photo"
            android:src="@drawable/ic_photo_camera"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btn_tool_camera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/filter_has_photo"
            android:src="@drawable/ic_photo_camera"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btn_tool_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/filter_has_audio"
            android:src="@drawable/ic_mic"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btn_tool_tag"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_tag_add"
            android:src="@drawable/ic_sell"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btn_tool_ambient"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/editor_ambient_rain"
            android:src="@drawable/ic_headphones"
            app:tint="@color/primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_word_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:text="0 từ"
            android:textColor="@color/text_tertiary"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
