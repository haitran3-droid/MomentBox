<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Thanh tiêu đề Toolbar (Action Bar) -->
    <LinearLayout
        android:id="@+id/layoutStatsToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvStatsTitle"
            style="@style/JournalTextSemibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:includeFontPadding="false"
            android:text="@string/stats_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_share"
            android:padding="8dp"
            android:src="@drawable/ic_journal_ios_share"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Khối cuộn nội dung thống kê -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Phân đoạn chọn kỳ: Tuần / Tháng / Năm -->
            <com.ntq.training.momentbox.feature.journal.view.JournalSegmentedGroup
                android:id="@+id/tgPeriod"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_segmented_container"
                android:padding="3dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPeriodWeek"
                    style="@style/JournalWidgetWidgetMomentBoxButtonSegmentedSemibold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/stats_period_week"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPeriodMonth"
                    style="@style/JournalWidgetWidgetMomentBoxButtonSegmentedSemibold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:textSize="13sp"
                    tools:text="Tháng 10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPeriodYear"
                    style="@style/JournalWidgetWidgetMomentBoxButtonSegmentedSemibold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/stats_period_year"
                    android:textSize="13sp" />
            </com.ntq.training.momentbox.feature.journal.view.JournalSegmentedGroup>
            <!-- Điều hướng kỳ có nhãn truy cập được, thay cho các hàm VM không có đường gọi từ UI. -->
            <LinearLayout
                android:id="@+id/layoutPeriodNavigation"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnPreviousPeriod"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/journal_period_previous"
                    android:padding="10dp"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/tvPeriodRange"
                    style="@style/JournalTextMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnNextPeriod"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/journal_period_next"
                    android:padding="10dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>


            <!-- Lưới 4 thẻ tóm tắt (2x2 Grid) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Thẻ 1: Bài viết -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_journal_edit_note"
                                app:tint="@color/primary" />

                            <TextView
                                style="@style/JournalTextMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/be_vietnam_pro_medium"
                                android:includeFontPadding="false"
                                android:text="@string/stats_card_entries"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:baselineAligned="true"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvEntriesCount"
                                style="@style/JournalTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                tools:text="18" />

                            <TextView
                                android:id="@+id/tvEntriesDelta"
                                style="@style/JournalTextSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/be_vietnam_pro_semibold"
                                android:includeFontPadding="false"
                                android:textColor="@color/success"
                                android:textSize="12sp"
                                tools:text="▲ 3" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ 2: Chuỗi hiện tại -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_journal_local_fire_department"
                                app:tint="#EA580C" />

                            <TextView
                                style="@style/JournalTextMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/be_vietnam_pro_medium"
                                android:includeFontPadding="false"
                                android:text="@string/stats_card_streak"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:baselineAligned="true"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStreakCount"
                                style="@style/JournalTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                tools:text="12" />

                            <TextView
                                style="@style/JournalTextSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/be_vietnam_pro_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/stats_unit_days"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ 3: Số từ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_journal_notes"
                                app:tint="#0EA5E9" />

                            <TextView
                                style="@style/JournalTextMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/be_vietnam_pro_medium"
                                android:includeFontPadding="false"
                                android:text="@string/stats_card_words"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvWordsCount"
                            style="@style/JournalTextBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            tools:text="6.240" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Thẻ 4: Ghi âm -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="5dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_mic"
                                app:tint="#DB2777" />

                            <TextView
                                style="@style/JournalTextMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/be_vietnam_pro_medium"
                                android:includeFontPadding="false"
                                android:text="@string/stats_card_audio"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:baselineAligned="true"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvAudioMinutes"
                                style="@style/JournalTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                tools:text="48" />

                            <TextView
                                style="@style/JournalTextSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/be_vietnam_pro_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/stats_unit_minutes"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Thẻ Biểu đồ tròn Phân bố cảm xúc (Donut Chart Card) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <!-- CSS118px scale.9/margin-6 tương đương footprint106dp. Canvas scale geometry trực tiếp để hit/accessibility cùng hệ tọa độ. -->
                    <com.ntq.training.momentbox.feature.journal.view.DonutChartView
                        android:id="@+id/donutChartView"
                        android:layout_width="106dp"
                        android:layout_height="106dp" />

                    <!-- Bảng tỷ lệ % cho 5 mức cảm xúc -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/JournalTextBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:includeFontPadding="false"
                            android:text="@string/stats_donut_title"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <!-- Mức 1: Tuyệt vời -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_stats_mood_key"
                                android:backgroundTint="@color/mood_1_great" />

                            <TextView
                                style="@style/JournalTextRegular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:includeFontPadding="false"
                                android:text="@string/mood_1_name"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/tvMood1Pct"
                                style="@style/JournalTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp"
                                tools:text="39%" />
                        </LinearLayout>

                        <!-- Mức 2: Vui -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_stats_mood_key"
                                android:backgroundTint="@color/mood_2_good" />

                            <TextView
                                style="@style/JournalTextRegular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:includeFontPadding="false"
                                android:text="@string/mood_2_name"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/tvMood2Pct"
                                style="@style/JournalTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp"
                                tools:text="28%" />
                        </LinearLayout>

                        <!-- Mức 3: Bình thường -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_stats_mood_key"
                                android:backgroundTint="@color/mood_3_okay" />

                            <TextView
                                style="@style/JournalTextRegular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:includeFontPadding="false"
                                android:text="@string/mood_3_name"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/tvMood3Pct"
                                style="@style/JournalTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp"
                                tools:text="17%" />
                        </LinearLayout>

                        <!-- Mức 4: Buồn -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_stats_mood_key"
                                android:backgroundTint="@color/mood_4_sad" />

                            <TextView
                                style="@style/JournalTextRegular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:includeFontPadding="false"
                                android:text="@string/mood_4_name"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/tvMood4Pct"
                                style="@style/JournalTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp"
                                tools:text="11%" />
                        </LinearLayout>

                        <!-- Mức 5: Tệ -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_stats_mood_key"
                                android:backgroundTint="@color/mood_5_terrible" />

                            <TextView
                                style="@style/JournalTextRegular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:includeFontPadding="false"
                                android:text="@string/mood_5_name"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/tvMood5Pct"
                                style="@style/JournalTextBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp"
                                tools:text="5%" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thẻ Biểu đồ đường Xu hướng cảm xúc (Line Chart Card) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/JournalTextBold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:includeFontPadding="false"
                            android:text="@string/stats_trend_title"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvTrendDateRange"
                            style="@style/JournalTextRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_regular"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp"
                            tools:text="1/10 – 21/10" />
                    </LinearLayout>

                    <com.ntq.training.momentbox.feature.journal.view.LineChartView
                        android:id="@+id/lineChartView"
                        android:layout_width="match_parent"
                        android:layout_height="116dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hàng danh sách Top Nhãn (Tags Row) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgStatsTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacing="8dp" />

            <!-- Thẻ Thông tin thông minh (Smart Insight Card) -->
            <LinearLayout
                android:id="@+id/layoutInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="#FFF8E1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/ic_journal_lightbulb"
                    app:tint="#F59E0B" />

                <TextView
                    android:id="@+id/tvInsightText"
                    style="@style/JournalTextRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.45"
                    android:textColor="#5A4500"
                    android:textSize="13sp"
                    tools:text="Bạn thường vui hơn vào cuối tuần (+32%) và viết nhiều nhất vào Chủ nhật." />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>