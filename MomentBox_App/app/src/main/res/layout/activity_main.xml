<?xml version="1.0" encoding="utf-8"?><!--
    activity_main.xml - Layout chính của ứng dụng MomentBox chứa 4 Tab chức năng (Host Activity).
    - Gồm 2 phần chính:
      1. `fragment_container`: FrameLayout chứa các Fragment (FeedFragment, JournalFragment, ChatFragment, ProfileFragment).
         Sử dụng cơ chế add/show/hide của FragmentManager để giữ nguyên vị trí cuộn khi người dùng chuyển đổi qua lại giữa các tab.
      2. `bottomNav`: Thanh điều hướng đáy (Bottom Navigation) cao 68dp theo đúng thiết kế Figma/mockup .bn,
         bao gồm 4 tab: Bảng tin, Nhật ký, Tin nhắn (có badge thông báo đỏ) và Cá nhân.
    - Áp dụng Window Insets: padding bottom tự động thích ứng với thanh điều hướng cử chỉ 3 nút hoặc pill vuốt của Android.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Container chứa các Fragment -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Thanh điều hướng đáy (Bottom Navigation Bar 68dp) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Bảng tin (Feed) -->
        <LinearLayout
            android:id="@+id/tabFeed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pillFeed"
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_voice_container">

                <ImageView
                    android:id="@+id/ivTabFeed"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_feed"
                    app:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTabFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Bảng tin"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Nhật ký (Journal) -->
        <LinearLayout
            android:id="@+id/tabJournal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pillJournal"
                android:layout_width="56dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivTabJournal"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_journal"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTabJournal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Nhật ký"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Nút Tạo bài viết trung tâm (+ Create CTA 54dp x 46dp gradient) -->
        <FrameLayout
            android:id="@+id/tabCreate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/btnNavCreate"
                android:layout_width="54dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_create"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />
            </FrameLayout>
        </FrameLayout>

        <!-- Tab 3: Tin nhắn (Chat) -->
        <LinearLayout
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pillChat"
                android:layout_width="56dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivTabChat"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_chat"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvChatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="5"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTabChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Tin nhắn"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Tab 4: Cá nhân (Profile) -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/pillProfile"
                android:layout_width="56dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/ivTabProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTabProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Cá nhân"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="normal" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>