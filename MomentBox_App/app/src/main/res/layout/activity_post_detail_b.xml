<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/postDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Quay lại"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Bài viết"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnMoreDetail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Tùy chọn"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- RecyclerView chính chứa ConcatAdapter (Header + Comments + Footer) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPostDetail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Banner hiển thị khi đang trả lời một bình luận khác -->
        <LinearLayout
            android:id="@+id/layoutReplyingBanner"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@color/surface_variant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvReplyingTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Đang trả lời Travel VN" />

            <ImageView
                android:id="@+id/btnCancelReply"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Hủy"
                android:src="@drawable/ic_close"
                app:tint="@color/text_tertiary" />
        </LinearLayout>

        <!-- Thanh nhập bình luận cố định dưới đáy (Bottom Comment Input Bar) -->
        <LinearLayout
            android:id="@+id/bottomCommentBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/ivCurrentUserAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@color/surface_variant"
                android:scaleType="centerCrop"
                tools:srcCompat="@drawable/ic_launcher_foreground" />

            <!-- Khung nhập liệu bo cong 21dp -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_comment_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <EditText
                    android:id="@+id/etCommentInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:hint="Viết bình luận…"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500"
                    android:maxLines="3"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp" />

                <!-- Đếm số ký tự chỉ hiện khi >= 450/500 -->
                <TextView
                    android:id="@+id/tvCharCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11.5sp"
                    android:visibility="gone"
                    tools:text="460/500"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/btnEmoji"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Emoji"
                    android:src="@drawable/ic_sentiment_satisfied"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Nút gửi bình luận tròn 42dp màu tím -->
            <FrameLayout
                android:id="@+id/btnSendComment"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_play_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Gửi bình luận"
                    android:src="@drawable/ic_send"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
