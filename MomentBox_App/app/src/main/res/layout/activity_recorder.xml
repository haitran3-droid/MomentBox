<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6FA"
    android:orientation="vertical">
    <!-- Clock/waveform chỉ render dữ liệu Service; không random sample hoặc tick Activity. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/record_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_close"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/JournalTextSemibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/m4_record_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <ImageButton
            android:id="@+id/record_recent"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_recent_records"
            android:src="@drawable/ic_m4_record_list" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <TextView
                    style="@style/JournalTextMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_m4_record_chip"
                    android:drawableStart="@drawable/ic_m4_format_wave"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="26dp"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:text="@string/m4_record_format"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/record_input"
                    style="@style/JournalTextMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_m4_record_chip"
                    android:drawableStart="@drawable/ic_m4_headset_mic"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="26dp"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/record_status"
                style="@style/JournalTextSemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/m4_record_ready"
                android:textColor="#E5484D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/record_time"
                style="@style/JournalTextSemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minHeight="80dp"
                android:text="00:00.0"
                android:textColor="@color/text_primary"
                android:textSize="54sp" />

            <com.ntq.training.momentbox.feature.recorder.RecordingWaveformView
                android:id="@+id/record_waveform"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/JournalTextRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_media_white_pill"
                android:drawableStart="@drawable/ic_m4_record_background"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:padding="7dp"
                android:text="@string/m4_record_background"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/record_cancel"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_media_white_circle"
                    android:contentDescription="@string/m4_discard"
                    android:elevation="2dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_media_delete" />

                <com.ntq.training.momentbox.feature.recorder.RecordButton
                    android:id="@+id/record_button"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="@string/m4_record_title" />

                <ImageButton
                    android:id="@+id/record_done"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_media_primary_circle"
                    android:contentDescription="@string/m4_done"
                    android:elevation="6dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_media_check" />
            </LinearLayout>

            <TextView
                android:id="@+id/record_remaining"
                style="@style/JournalTextRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="40dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/JournalTextSemibold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/m4_recent_records"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/record_see_all"
                            style="@style/JournalTextSemibold"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:minWidth="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/m4_see_all"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingBottom="8dp">

                        <ImageButton
                            android:id="@+id/record_recent_play"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_m4_recent_play"
                            android:contentDescription="@string/journal_audio_play"
                            android:padding="14dp"
                            android:src="@drawable/ic_media_play"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/record_recent_title"
                                style="@style/JournalTextMedium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/m4_no_recent"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/record_recent_details"
                                style="@style/JournalTextRegular"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_tertiary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>