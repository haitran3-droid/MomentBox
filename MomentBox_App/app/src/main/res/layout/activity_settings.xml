<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/settingsBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/s22_back"
            android:padding="12dp"
            android:src="@drawable/ic_s22_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/S22Semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.0105"
            android:paddingStart="4dp"
            android:text="@string/s22_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            app:fontFamily="@font/be_vietnam_pro_semibold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/settingsAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_s22_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/settingsInitials"
                        style="@style/S22Semibold"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_s22_avatar"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        app:fontFamily="@font/be_vietnam_pro_semibold" />

                    <ImageView
                        android:id="@+id/settingsAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/settingsName"
                        style="@style/S22Semibold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        app:fontFamily="@font/be_vietnam_pro_semibold" />

                    <TextView
                        android:id="@+id/settingsEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12.5sp"
                        app:fontFamily="@font/be_vietnam_pro" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_s22_chevron_right"
                    app:tint="@color/text_tertiary" />
            </LinearLayout>

            <TextView
                style="@style/S22Section"
                android:includeFontPadding="false"
                android:text="@string/s22_section_general" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_s22_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <include
                    android:id="@+id/settingsLanguage"
                    layout="@layout/item_settings_row" />

                <include
                    android:id="@+id/settingsTheme"
                    layout="@layout/item_settings_row" />

                <include
                    android:id="@+id/settingsReminder"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <TextView
                style="@style/S22Section"
                android:includeFontPadding="false"
                android:text="@string/s22_section_data" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_s22_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <include
                    android:id="@+id/settingsCache"
                    layout="@layout/item_settings_row" />

                <include
                    android:id="@+id/settingsExport"
                    layout="@layout/item_settings_row" />

                <include
                    android:id="@+id/settingsAutoplay"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <TextView
                style="@style/S22Section"
                android:includeFontPadding="false"
                android:text="@string/s22_section_other" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_s22_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <include
                    android:id="@+id/settingsPermissions"
                    layout="@layout/item_settings_row" />

                <include
                    android:id="@+id/settingsDeveloper"
                    layout="@layout/item_settings_row" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsLogout"
                style="@style/S22Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:insetTop="2dp"
                android:insetBottom="2dp"
                android:text="@string/s22_logout"
                android:textAllCaps="false"
                android:textColor="@color/error"
                android:textSize="14sp"
                app:backgroundTint="@color/error_container"
                app:cornerRadius="14dp"
                app:fontFamily="@font/be_vietnam_pro_semibold"
                app:icon="@drawable/ic_s22_logout"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/error" />

            <TextView
                android:id="@+id/settingsVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
