<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_journal_filter_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Tay cầm kéo BottomSheet (Drag Handle) -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/outline" />

    <!-- Thanh tiêu đề & Nút "Đặt lại" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/JournalTextBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:includeFontPadding="false"
            android:text="@string/filter_title"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/btnResetFilter"
            style="@style/JournalTextSemibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:includeFontPadding="false"
            android:padding="4dp"
            android:text="@string/filter_reset"
            android:textColor="@color/primary"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFilterOptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. SẮP XẾP THEO -->
            <TextView
                style="@style/JournalTextSemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:includeFontPadding="false"
                android:text="@string/filter_sort_by"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgSortBy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbSortNewest"
                    style="@style/JournalTextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:button="@null"
                    android:buttonTint="@color/sl_journal_control"
                    android:drawableStart="@drawable/sl_journal_radio"
                    android:drawablePadding="12dp"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:paddingStart="0dp"
                    android:text="@string/filter_sort_newest"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    app:buttonCompat="@null"
                    app:buttonTint="@color/sl_journal_control" />

                <RadioButton
                    android:id="@+id/rbSortOldest"
                    style="@style/JournalTextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:button="@null"
                    android:buttonTint="@color/sl_journal_control"
                    android:drawableStart="@drawable/sl_journal_radio"
                    android:drawablePadding="12dp"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:paddingStart="0dp"
                    android:text="@string/filter_sort_oldest"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    app:buttonCompat="@null"
                    app:buttonTint="@color/sl_journal_control" />

                <RadioButton
                    android:id="@+id/rbSortMood"
                    style="@style/JournalTextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:button="@null"
                    android:buttonTint="@color/sl_journal_control"
                    android:drawableStart="@drawable/sl_journal_radio"
                    android:drawablePadding="12dp"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:paddingStart="0dp"
                    android:text="@string/filter_sort_mood"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    app:buttonCompat="@null"
                    app:buttonTint="@color/sl_journal_control" />
            </RadioGroup>

            <!-- 2. NHÓM THEO -->
            <TextView
                style="@style/JournalTextSemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:includeFontPadding="false"
                android:text="@string/filter_group_by"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.ntq.training.momentbox.feature.journal.view.JournalSegmentedGroup
                android:id="@+id/tgGroupBy"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_segmented_container"
                android:padding="3dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGroupDay"
                    style="@style/JournalWidgetWidgetMomentBoxButtonSegmentedMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:text="@string/filter_group_day"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGroupWeek"
                    style="@style/JournalWidgetWidgetMomentBoxButtonSegmentedMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:text="@string/filter_group_week"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGroupMonth"
                    style="@style/JournalWidgetWidgetMomentBoxButtonSegmentedMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:text="@string/filter_group_month"
                    android:textSize="13sp" />
            </com.ntq.training.momentbox.feature.journal.view.JournalSegmentedGroup>

            <!-- 3. CẢM XÚC -->
            <TextView
                style="@style/JournalTextSemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:includeFontPadding="false"
                android:text="@string/filter_mood_title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgMoods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacing="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMood1"
                    style="@style/JournalWidgetWidgetMomentBoxChipJournalFilterMedium"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:text="@string/journal_mood_chip_1"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMood2"
                    style="@style/JournalWidgetWidgetMomentBoxChipJournalFilterMedium"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:text="@string/journal_mood_chip_2"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMood3"
                    style="@style/JournalWidgetWidgetMomentBoxChipJournalFilterMedium"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:text="@string/journal_mood_chip_3"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMood4"
                    style="@style/JournalWidgetWidgetMomentBoxChipJournalFilterMedium"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:text="@string/journal_mood_chip_4"
                    android:textSize="13sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMood5"
                    style="@style/JournalWidgetWidgetMomentBoxChipJournalFilterMedium"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:text="@string/journal_mood_chip_5"
                    android:textSize="13sp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- 4. ĐÍNH KÈM -->
            <TextView
                style="@style/JournalTextSemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:includeFontPadding="false"
                android:text="@string/filter_attachment_title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cbHasPhoto"
                    style="@style/JournalTextMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:button="@null"
                    android:drawableStart="@drawable/sl_journal_checkbox_glyph"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:text="@string/filter_has_photo"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    app:buttonCompat="@null" />

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cbHasAudio"
                    style="@style/JournalTextMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="22dp"
                    android:button="@null"
                    android:drawableStart="@drawable/sl_journal_checkbox_glyph"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:text="@string/filter_has_audio"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    app:buttonCompat="@null" />
            </LinearLayout>

            <!-- 5. KHOẢNG THỜI GIAN -->
            <TextView
                style="@style/JournalTextSemibold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:includeFontPadding="false"
                android:text="@string/filter_date_range_title"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutDateRangePicker"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field_default"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_journal_date_range"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvDateRangeText"
                    style="@style/JournalTextRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:includeFontPadding="false"
                    android:text="@string/filter_all_time"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnClearDateRange"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:src="@drawable/ic_journal_close"
                    android:visibility="gone"
                    app:tint="@color/text_secondary"
                    tools:visibility="visible" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- NÚT ÁP DỤNG KÈM SỐ KẾT QUẢ ĐỘNG (CTA Button) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFilter"
        style="@style/JournalTextSemibold"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/be_vietnam_pro_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/filter_apply_no_count"
        android:textColor="@color/surface"
        android:textSize="15sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="14dp" />

</LinearLayout>