<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">
    <!-- Chip ôm nội dung như CSS; Flow xuống dòng khi locale/font lớn, giữ nút tạo chat chạm được. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/chatListTitle"
            style="@style/M5ChatListTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:letterSpacing="-0.008333333"
            android:paddingStart="6dp"
            android:text="@string/m5_chat_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/connection"
            style="@style/M5ChatConnectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_chip"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:maxWidth="120dp"
            android:maxLines="2"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:textColor="@color/mood_1_text"
            android:textSize="11.5sp"
            app:drawableStartCompat="@drawable/ic_chat_connection_dot" />

        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="chatListTitle,connection"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="10dp"
            app:flow_horizontalStyle="packed"
            app:flow_verticalAlign="center"
            app:flow_verticalGap="4dp"
            app:flow_wrapMode="chain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/newChat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/newChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m5_chat_new"
            android:padding="12dp"
            android:src="@drawable/ic_chat_edit_square"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chat_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:hint="@string/m5_chat_search"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textSize="14sp"
        app:drawableTint="@color/text_tertiary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/onlineUsers"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chip_api_mock_bg"
        android:padding="12dp"
        android:text="@string/m5_chat_error"
        android:textColor="@color/chip_api_mock_text"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:text="@string/m5_chat_empty"
            android:textColor="@color/text_secondary" />
    </FrameLayout>
</LinearLayout>