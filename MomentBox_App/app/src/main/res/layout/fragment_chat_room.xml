<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m5_chat_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null" />

            <View
                android:id="@+id/onlineDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_chat_online" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:maxLines="1"
                android:textSize="15.5sp" />

            <TextView
                android:id="@+id/presence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/success"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/info"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m5_chat_info"
            android:padding="12dp"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <TextView
        android:id="@+id/connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chip_api_mock_bg"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/m5_chat_offline"
        android:textColor="@color/chip_api_mock_text"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/m5_chat_error"
        android:textColor="@color/error"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newMessages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:text="@string/m5_chat_new_messages"
            android:visibility="gone" />
    </FrameLayout>

    <com.ntq.training.momentbox.feature.chat.ChatTypingView
        android:id="@+id/typing"
        android:layout_width="69dp"
        android:layout_height="31dp"
        android:layout_marginVertical="6dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/m5_chat_typing"
        android:visibility="gone" />

    <TextView
        android:id="@+id/quickStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_container"
        android:gravity="center"
        android:minHeight="40dp"
        android:padding="8dp"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/attach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m5_chat_attach"
            android:padding="12dp"
            android:src="@drawable/ic_add_circle"
            app:tint="@color/primary" />

        <ImageButton
            android:id="@+id/camera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_camera"
            android:padding="12dp"
            android:src="@drawable/ic_photo_camera"
            app:tint="@color/primary" />

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_search"
            android:hint="@string/m5_chat_message"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxHeight="126dp"
            android:minHeight="42dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chat_send"
            android:contentDescription="@string/m5_chat_send"
            android:padding="14dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>