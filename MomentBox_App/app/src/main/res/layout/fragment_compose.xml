<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">
    <!-- S15: controls cuộn với IME, progress nằm cuối; upload dùng snapshot khóa thay đổi. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/compose_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/JournalTextSemibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/m4_compose"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compose_post"
            style="@style/Widget.MomentBox.MediaButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:text="@string/m4_post" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/compose_avatar"
                    style="@style/JournalTextBold"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_media_avatar"
                    android:gravity="center"
                    android:text="MB"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/compose_author"
                        style="@style/JournalTextSemibold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/compose_privacy"
                        style="@style/JournalTextMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_media_privacy"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/m4_public"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/compose_caption"
                style="@style/JournalTextRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@null"
                android:gravity="top"
                android:hint="@string/m4_caption_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="2200"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/compose_counter"
                style="@style/JournalTextRegular"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="end|center_vertical"
                android:paddingEnd="16dp"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/compose_media"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                style="@style/JournalTextRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/m4_reorder_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compose_add"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:text="@string/m4_add"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/compose_voice_bar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_media_voice"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/compose_voice_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/journal_audio_play"
                    android:src="@drawable/ic_journal_play_arrow" />

                <com.ntq.training.momentbox.feature.journal.view.AudioWaveformView
                    android:id="@+id/compose_voice_waveform"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/compose_voice_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary" />

                <ImageButton
                    android:id="@+id/compose_voice_remove"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/m4_discard"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/compose_record"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:text="@string/m4_record_title"
                app:icon="@drawable/ic_journal_mic" />

            <TextView
                android:id="@+id/compose_location"
                style="@style/JournalTextRegular"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_media_location"
                android:drawableEnd="@drawable/ic_expand_more"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/m4_location"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/compose_comments"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:drawableStart="@drawable/ic_media_comments"
                android:drawablePadding="12dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/m4_comments"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/compose_journal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:drawableStart="@drawable/ic_media_journal"
                android:drawablePadding="12dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/m4_save_journal"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/compose_video_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/m4_video_journal"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/compose_upload_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#211A40"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/compose_upload_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/compose_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100" />

        <TextView
            android:id="@+id/compose_cancel_upload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>