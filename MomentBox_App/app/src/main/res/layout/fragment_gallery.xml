<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/gallery_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/gallery_album"
            style="@style/JournalTextSemibold"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:drawableEnd="@drawable/ic_expand_more"
            android:drawablePadding="2dp"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:gravity="center_vertical"
            android:letterSpacing="-0.01"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:text="@string/m4_recent"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gallery_next"
            style="@style/Widget.MomentBox.MediaButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:text="@string/m4_next_zero"
            android:textColor="@color/white" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/gallery_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_all"
                style="@style/Widget.MomentBox.MediaChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:checked="true"
                android:text="@string/m4_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_photo"
                style="@style/Widget.MomentBox.MediaChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/m4_photos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_video"
                style="@style/Widget.MomentBox.MediaChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/m4_videos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_favorite"
                style="@style/Widget.MomentBox.MediaChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/m4_favorites"
                app:chipIcon="@drawable/ic_m4_favorite"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/media_chip_text"
                app:chipIconVisible="true" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/gallery_partial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_media_permission"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_m4_info" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:text="@string/m4_partial"
            android:textColor="#5A4500"
            android:textSize="12.5sp"
            app:lineHeight="17.5sp" />

        <TextView
            android:id="@+id/gallery_manage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/m4_manage"
            android:textColor="@color/primary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gallery_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:padding="16dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gallery_permission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/m4_grant"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gallery_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
