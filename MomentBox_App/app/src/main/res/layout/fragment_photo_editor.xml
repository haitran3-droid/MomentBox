<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:orientation="vertical">
    <!-- S13: canvas riêng và khay công cụ thật; không xuất handles hay ngón tay minh họa. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/editor_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_close"
            android:src="@drawable/ic_journal_chevron_left"
            app:tint="#FFFFFF" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/editor_undo"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_undo"
            android:src="@drawable/ic_media_undo" />

        <ImageButton
            android:id="@+id/editor_redo"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_redo"
            android:src="@drawable/ic_media_redo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editor_save"
            style="@style/Widget.MomentBox.MediaButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:text="@string/m4_save" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#19191F"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <com.ntq.training.momentbox.feature.editor.StickerCanvasView
            android:id="@+id/editor_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/editor_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:padding="8dp"
        android:text="@string/m4_gesture_hint"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/editor_tools"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#19191F"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/editor_categories"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="#19191F">

        <GridLayout
            android:id="@+id/editor_tray"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="6"
            android:padding="12dp" />

        <LinearLayout
            android:id="@+id/editor_adjustments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/editor_brightness"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/m4_brightness"
                android:max="200"
                android:progress="100" />

            <SeekBar
                android:id="@+id/editor_contrast"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/m4_contrast"
                android:max="200"
                android:progress="100" />

            <SeekBar
                android:id="@+id/editor_saturation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/m4_saturation"
                android:max="200"
                android:progress="100" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>