<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:orientation="vertical">
    <!-- S13: canvas riêng và khay công cụ thật; không xuất handles hay ngón tay minh họa. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/editor_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_close"
            android:src="@drawable/ic_m4_arrow_back"
            app:tint="#FFFFFF" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/editor_undo"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_undo"
            android:src="@drawable/ic_media_undo" />

        <ImageButton
            android:id="@+id/editor_redo"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_redo"
            android:src="@drawable/ic_media_redo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editor_save"
            style="@style/Widget.MomentBox.MediaButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:text="@string/m4_save" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#19191F"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.ntq.training.momentbox.feature.editor.StickerCanvasView
                android:id="@+id/editor_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/editor_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_m4_editor_hint"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/m4_gesture_hint"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Nhãn tool dài/font lớn có thể cuộn ngang, không cắt mất chữ Điều chỉnh ở320dp. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:minHeight="69dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/editor_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="69dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:background="@drawable/bg_m4_editor_tray"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/editor_categories"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridLayout
                android:id="@+id/editor_tray"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="6"
                android:padding="12dp"
                android:paddingTop="0dp" />

            <LinearLayout
                android:id="@+id/editor_adjustments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/editor_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/m4_brightness"
                    android:max="200"
                    android:progress="100" />

                <SeekBar
                    android:id="@+id/editor_contrast"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/m4_contrast"
                    android:max="200"
                    android:progress="100" />

                <SeekBar
                    android:id="@+id/editor_saturation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/m4_saturation"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>