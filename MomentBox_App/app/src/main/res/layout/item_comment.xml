<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- Avatar người bình luận 32dp -->
        <ImageView
            android:id="@+id/ivCommentAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/surface_variant"
            android:scaleType="centerCrop"
            tools:srcCompat="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Bong bóng bình luận bo góc 4dp 16dp 16dp 16dp -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_comment_bubble"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvCommentAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    tools:text="Travel VN" />

                <TextView
                    android:id="@+id/tvCommentContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    tools:text="Đẹp quá chị ơi! Cho em xin địa chỉ đồi chè với 😍" />
            </LinearLayout>

            <!-- Hàng thông tin phụ: Thời gian, Thích, Trả lời -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/tvCommentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="15 phút" />

                <TextView
                    android:id="@+id/btnLikeComment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="Thích"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnReplyComment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="Trả lời"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trái tim thích bình luận bên phải -->
        <LinearLayout
            android:id="@+id/btnCommentLikeAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivCommentLike"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Thích"
                android:src="@drawable/ic_favorite"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/tvCommentLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                tools:text="12" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hàng mở rộng câu trả lời con: Xem N phản hồi -->
    <LinearLayout
        android:id="@+id/layoutExpandReplies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="24dp"
            android:layout_height="1dp"
            android:layout_marginEnd="8dp"
            android:background="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvExpandRepliesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="Xem 2 phản hồi" />
    </LinearLayout>
</LinearLayout>