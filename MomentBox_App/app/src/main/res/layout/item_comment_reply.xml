<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="54dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/ivReplyAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_avatar_placeholder"
        android:scaleType="centerCrop"
        tools:srcCompat="@drawable/ic_launcher_foreground"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_comment_bubble"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvReplyAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Lan Anh" />

            <TextView
                android:id="@+id/tvReplyContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="Cảm ơn bạn nhiều nha!" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tvReplyTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="5 phút" />

            <TextView
                android:id="@+id/btnLikeReply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/action_like"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivReplyLike"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/action_like"
            android:src="@drawable/ic_favorite"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvReplyLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            tools:text="3" />
    </LinearLayout>
</LinearLayout>