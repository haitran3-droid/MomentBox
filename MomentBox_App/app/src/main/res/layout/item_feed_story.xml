<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="68dp"
    android:layout_marginEnd="10dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <!-- Lớp 1: Vòng viền Story gradient / seen dạng oval -->
        <View
            android:id="@+id/viewStoryRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_story_ring_unread" />

        <!-- Lớp 2: Viền đệm trắng ngăn cách giữa vòng ngoài và avatar -->
        <View
            android:id="@+id/viewStoryRingGap"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_story_ring_seen"
            android:backgroundTint="@color/white" />

        <!-- Lớp 3: Ảnh đại diện Story tròn -->
        <ImageView
            android:id="@+id/ivStoryAvatar"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_placeholder"
            android:scaleType="centerCrop"
            tools:srcCompat="@drawable/bg_avatar_placeholder" />

        <!-- Nút dấu + thêm story cá nhân -->
        <FrameLayout
            android:id="@+id/btnAddStory"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_play_circle"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvStoryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/be_vietnam_pro"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="Tin của bạn" />
</LinearLayout>