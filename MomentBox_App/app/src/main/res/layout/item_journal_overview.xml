<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <!-- Thẻ Lịch cảm xúc (MoodCalendarView) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- Thanh điều hướng tháng & Chuỗi viết liên tục -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="0dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvCalendarMonth"
                    style="@style/JournalTextBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15.5sp"
                    tools:text="Tháng 10, 2026" />

                <ImageView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_journal_chevron_left"
                    app:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_journal_chevron_right"
                    app:tint="@color/text_primary" />

                <!-- Huy hiệu chuỗi ngày viết liên tục (Streak) -->
                <TextView
                    android:id="@+id/tvCalendarStreak"
                    style="@style/JournalTextBold"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_streak"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="#C2410C"
                    android:textSize="12sp"
                    tools:text="🔥 12 ngày" />
            </LinearLayout>

            <!-- Custom View vẽ lịch bằng Canvas -->
            <com.ntq.training.momentbox.feature.journal.view.MoodCalendarView
                android:id="@+id/moodCalendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Trạng thái trống (Empty State khi chưa có bài viết) -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_nav_journal"
            app:tint="@color/text_tertiary" />

        <TextView
            style="@style/JournalTextBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:includeFontPadding="false"
            android:text="@string/journal_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            style="@style/JournalTextRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/journal_empty_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>


</LinearLayout>
