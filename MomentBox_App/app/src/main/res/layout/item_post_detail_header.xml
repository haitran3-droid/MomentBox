<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Header tác giả -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/ivDetailAuthorAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/surface_variant"
            android:scaleType="centerCrop"
            tools:srcCompat="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Lan Anh" />

            <TextView
                android:id="@+id/tvDetailPostMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                tools:text="2 giờ trước · Đà Lạt · Công khai" />
        </LinearLayout>

        <!-- Nút Theo dõi -->
        <TextView
            android:id="@+id/btnDetailFollow"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_btn_tonal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Theo dõi"
            android:textColor="@color/on_primary_container"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Album ảnh / Media Container -->
    <FrameLayout
        android:id="@+id/detailMediaContainer"
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpDetailPhotos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/layoutDetailCounter"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pill_counter"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_collections"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvDetailPhotoCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/white"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="1/3" />
        </LinearLayout>
    </FrameLayout>

    <!-- Hàng nút tương tác: Like, Comment, Share, Bookmark -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/btnDetailLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDetailLike"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Thích"
                android:src="@drawable/ic_favorite"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvDetailLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="128" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnDetailComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDetailComment"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Bình luận"
                android:src="@drawable/ic_chat_bubble"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvDetailCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="24" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnDetailShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Chia sẻ"
                android:src="@drawable/ic_send"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/btnDetailBookmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDetailBookmark"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Lưu bài viết"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/text_primary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Chú thích chi tiết kèm Hashtag -->
    <TextView
        android:id="@+id/tvDetailCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/be_vietnam_pro"
        android:lineSpacingExtra="3.5dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textSize="13.5sp"
        tools:text="Sáng sớm ở đồi chè Cầu Đất, sương phủ kín cả thung lũng... #dalat #travel" />

    <!-- Đường phân cách mảnh -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />

    <!-- Thanh tiêu đề Bình luận & Nút sắp xếp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvCommentsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Bình luận (24)" />

        <!-- Chip chuyển đổi sắp xếp: Phù hợp nhất / Mới nhất -->
        <LinearLayout
            android:id="@+id/btnSortComments"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/tvSortLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Phù hợp nhất"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>