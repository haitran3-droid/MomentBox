<resources xmlns:app="http://schemas.android.com/apk/res-auto">
    <style name="Widget.MomentBox.MediaButton" parent="Widget.MaterialComponents.Button">
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="Widget.MomentBox.MediaChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">32dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipBackgroundColor">@color/media_chip_background</item>
        <item name="android:textColor">@color/media_chip_text</item>
    </style>

    <style name="Media.CameraControl" parent="">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:gravity">center</item>
    </style>
</resources>