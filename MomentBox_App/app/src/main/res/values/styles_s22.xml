<?xml version='1.0' encoding='utf-8'?>
<resources>

    <style name="S22SectionBase">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="fontFamily">@font/be_vietnam_pro_bold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style
        name="S22Section"
        parent="S22SectionBase" />

    <style name="S22SemiboldBase">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style
        name="S22Semibold"
        parent="S22SemiboldBase" />

    <style name="S22MediumBase">
        <item name="android:fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="fontFamily">@font/be_vietnam_pro_medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style
        name="S22Medium"
        parent="S22MediumBase" />

    <style
        name="S22ButtonBase"
        parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="fontFamily">@font/be_vietnam_pro_semibold</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style
        name="S22Button"
        parent="S22ButtonBase" />
</resources>
